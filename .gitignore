# Only the kit's own code is in git. Everything downloaded or personal stays out:
# ignore everything at the top level, then list what belongs in the repository.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CREDITS.md
!/install.sh
!/Запустити - Start.command
!/Встановити - Install.command
!/Перевірити - Check.command
!/README.en.md
!/Тривожна валіза - посібник для друку.pdf
!/Emergency Kit - printable guide.pdf
!/get.sh
!/config/
!/scripts/
!/web/
!/docs/
!/CONTEXT.md
!/CLAUDE.md
!/.github/
!/tests/
!/package.json
!/package-lock.json

# Built or downloaded inside web/
/web/index.html
/web/map/data/
.DS_Store
__pycache__/

# Agent working files stay local
.scratch/
