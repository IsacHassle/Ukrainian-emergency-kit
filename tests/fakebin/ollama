#!/bin/bash
# Stand-in for the ollama command: records what the kit asks, and knows only the models the test set in EK_FAKE_MODELS.
echo "ollama $*" >> "${EK_FAKE_LOG:-/dev/null}"
case "$1" in
  show) case " ${EK_FAKE_MODELS:-gemma4:26b gemma4:e4b bge-m3 emergency emergency-small} " in *" $2 "*) exit 0 ;; *) exit 1 ;; esac ;;
esac
exit 0
